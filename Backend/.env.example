# Copy this file to `.env` and fill in the real values.

# Z.ai API key (https://z.ai) used by the LLM structuring stage (GLM-4.7-FlashX).
ZAI_API_KEY=

# Optional overrides — defaults to GLM-4.7-FlashX on Z.ai's international
# endpoint if omitted. Only set these if using a different GLM model or
# Z.ai's mainland China endpoint instead.
# ZAI_MODEL=glm-4.7-flashx
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# Google Gemini API key used by the inquiry-classification stage
# (Agent/WhatsAppInquiryHandlingAgent/inquiry_classifier.py) to decide
# whether an incoming WhatsApp message is property-related.
GEMINI_API_KEY=

# Optional override — defaults to gemini-2.5-flash-lite if omitted.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Postgres connection string (with pgvector enabled), used by the whole
# app — both the property-listing tables and whatsappInquiryHandling's
# client-records tables live in this one database, under separate tables.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Base URL the registration/update form link sent over WhatsApp is built
# from. Optional — leave blank to auto-detect this machine's LAN IP at
# startup (e.g. http://192.168.1.50:5174/enquire), which is what a phone
# actually needs: a "localhost" link only opens from THIS machine's own
# browser, since "localhost" on the phone resolves to the phone itself.
# Note the port and path: this points at the PUBLIC SITE (LandingPage/,
# 5174), whose /enquire/<token> route opens the landing page scrolled to
# the requirements form and prefilled — not the internal tool on 5173.
# Set this explicitly only to point at a real deployed site instead of a
# LAN dev server.
INQUIRY_FORM_BASE_URL=

# Extra CORS-allowed origin matching the LAN IP above, e.g.
# http://192.168.1.50:5173 (no trailing slash). Optional — leave blank to
# auto-detect alongside INQUIRY_FORM_BASE_URL; set explicitly only when
# overriding that with a real deployed frontend origin.
FRONTEND_LAN_ORIGIN=

# How long the buffer waits for 10 qualified messages before flushing
# whatever it has anyway, in MINUTES. 60 = 1 hour. Optional — defaults to
# 60 if omitted. Lower this for fast local testing.
BATCH_WINDOW_MINUTES=60

# Phone number the Instagram DM sequence tells an interested commenter to
# call to book an offline site visit. Write it as it should be read, e.g.
# "+91 98765 43210". Leave blank to send the no-number wording instead —
# never a placeholder.
BUSINESS_CONTACT_PHONE=

# Per-identity daily allowances — how much ONE personal WhatsApp number, or
# ONE Instagram account, may cost this backend in a day (the day turning
# over at 6 AM IST). See Backend/Middleware/daily_quota.py. Anything past
# the allowance is dropped where it arrives: no LLM call, no database
# lookup, no reply. Set a value to 0 to turn that limit off.
WHATSAPP_DAILY_MESSAGE_LIMIT=20
WHATSAPP_DAILY_WORD_LIMIT=200
INSTAGRAM_DAILY_COMMENT_LIMIT=10
INSTAGRAM_DAILY_DM_LIMIT=10
