# Copy this file to `.env` and fill in the real values.

# Z.ai API key (https://z.ai) used by every LLM call this backend makes —
# property structuring, requirement structuring, and inquiry classification.
ZAI_API_KEY=

# Optional overrides — defaults to GLM-4.6 for property/requirement
# structuring and GLM-4.7-FlashX for inquiry classification (deciding
# whether an incoming WhatsApp message is property-related) on Z.ai's
# international endpoint if omitted. Only set these if using a different GLM
# model or Z.ai's mainland China endpoint instead.
# ZAI_MODEL=glm-4.6
# ZAI_INQUIRY_MODEL=glm-4.7-flashx
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4/

# Postgres connection string (with pgvector enabled), used by the whole
# app — both the property-listing tables and whatsappInquiryHandling's
# client-records tables live in this one database, under separate tables.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Base URL the registration/update form link sent over WhatsApp is built
# from. Optional — leave blank to auto-detect this machine's LAN IP at
# startup (e.g. http://192.168.1.50:5174/enquire), which is what a phone
# actually needs: a "localhost" link only opens from THIS machine's own
# browser, since "localhost" on the phone resolves to the phone itself.
# Note the port and path: this points at the PUBLIC SITE (LandingPage/,
# 5174), whose /enquire/<token> route opens the landing page scrolled to
# the requirements form and prefilled — not the internal tool on 5173.
# Set this explicitly only to point at a real deployed site instead of a
# LAN dev server.
INQUIRY_FORM_BASE_URL=

# Extra CORS-allowed origin matching the LAN IP above, e.g.
# http://192.168.1.50:5173 (no trailing slash). Optional — leave blank to
# auto-detect alongside INQUIRY_FORM_BASE_URL; set explicitly only when
# overriding that with a real deployed frontend origin.
FRONTEND_LAN_ORIGIN=

# How long the buffer waits for 10 qualified messages before flushing
# whatever it has anyway, in MINUTES. 60 = 1 hour. Optional — defaults to
# 60 if omitted. Lower this for fast local testing.
BATCH_WINDOW_MINUTES=60

# Not used by any message right now (the Instagram DM sequence no longer
# tells people to call a number). Safe to leave blank or remove.
BUSINESS_CONTACT_PHONE=

# --- Instagram (Meta's official Instagram Platform API) ---------------------
#
# All of these come from ONE Meta app: App Dashboard -> your app -> Instagram
# -> "API setup with Instagram business login".
#
# INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET are the *Instagram* app ID and
# secret shown on that screen (step 3 of the setup panel), NOT the Facebook
# App ID at the very top of the dashboard. The secret is what Meta signs every
# webhook delivery with, so without it this server cannot prove a delivery
# really came from Meta.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Optional. Set this to App settings -> Basic -> "App secret" as well. Meta
# has signed Instagram webhooks with either of the two secrets depending on
# how the app was created, and the webhook route accepts whichever one
# matches — setting both removes an entire class of "every event is rejected
# as unsigned" confusion.
FACEBOOK_APP_SECRET=

# A string YOU invent. Type the identical value into the "Verify token" box
# next to the callback URL in the dashboard's "Configure webhooks" panel.
# Meta echoes it back once, on the GET handshake that activates the callback
# URL — it is not a credential Meta issues, it is how this server knows the
# handshake is really for it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# The callback URL to paste into that same panel is this server's public
# address plus /api/instagram/webhook, e.g.
#   https://your-tunnel.ngrok-free.dev/api/instagram/webhook
# (the Instagram tab of the Connection page prints the exact value for the
# address the browser reached this API on, so it can be copied rather than
# assembled by hand).

# The public address Meta reaches this backend on, with no trailing slash —
# the ngrok tunnel while developing, the Railway domain once hosted. Used
# only so the Connection page can print the exact callback URL and OAuth
# redirect URI to paste into the dashboard. Leave blank to derive them from
# the address the browser reached this API on, which is right once hosted but
# wrong while developing (the browser reaches the backend on the LAN, while
# Meta reaches it through the tunnel).
INSTAGRAM_PUBLIC_BASE_URL=

# Only needed for the production "Connect with Instagram" button, which sends
# the operator through Instagram's own consent screen. Set it to this
# server's public address plus /api/instagram/oauth/callback, and add the
# IDENTICAL string to the app's "OAuth redirect URIs" list under Instagram ->
# Business login settings. Leave blank to connect by pasting a token
# generated in the dashboard instead (which needs no redirect URI at all).
INSTAGRAM_REDIRECT_URI=

# Optional overrides. The Graph version is pinned rather than "latest" so a
# silent bump can never change payload shapes underneath a running
# deployment.
# INSTAGRAM_GRAPH_VERSION=v23.0
# INSTAGRAM_API_TIMEOUT_SECONDS=20

# Where the Instagram OAuth callback sends the browser back to — the internal
# tool's origin (Frontend/, port 5173). Optional: leave blank to reuse the
# auto-detected LAN origin, which is right for local development. Set it
# explicitly to the deployed frontend URL when hosting.
FRONTEND_BASE_URL=

# Per-identity daily allowances — how much ONE personal WhatsApp number, or
# ONE Instagram account, may cost this backend in a day (the day turning
# over at 6 AM IST). See Backend/Middleware/daily_quota.py. Anything past
# the allowance is dropped where it arrives: no LLM call, no database
# lookup, no reply. Set a value to 0 to turn that limit off.
WHATSAPP_DAILY_MESSAGE_LIMIT=20
WHATSAPP_DAILY_WORD_LIMIT=200
INSTAGRAM_DAILY_COMMENT_LIMIT=10
INSTAGRAM_DAILY_DM_LIMIT=10

# How long the embedding model may sit unused before it is released from
# memory, in MINUTES. It reloads by itself (a second or two) on the next
# embedding, so the vectors it produces are completely unaffected — this
# only decides how much RAM the backend holds while nobody is saving a
# property, builder project or requirement. Set to 0 to keep the model
# loaded from its first use until the process exits.
EMBEDDING_MODEL_IDLE_UNLOAD_MINUTES=15

# Whether the Settings page may change the selected areas. false = the list
# is read-only (the API refuses changes too); true = editable. Restart the
# backend after changing this.
ALLOW_AREA_CHANGE=false

# Send each property's photos to a client as ONE WhatsApp album with the
# details underneath (true), or one photo per message with the details on the
# last one (false — the long-standing behaviour). Try true by sending a
# shortlist to your own number; keep it only if the photos and details show
# up. Restart the backend after changing this.
PROPERTY_PHOTOS_AS_ALBUM=false

# Login accounts (Service/AuthManagementService/) — required for anyone to
# be able to log in at all.
#
# JWT_SECRET_KEY signs every login token; pick a long random string (e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`) and never
# change it casually once set — changing it logs every signed-in user out.
JWT_SECRET_KEY=
# Optional — defaults to 24 if omitted. How long one login token stays valid.
# While the user is active the app keeps swapping it for a fresh one, so an
# active user is never signed out; an idle user is signed out after 12 hours
# without activity. Keep this above 12.
JWT_EXPIRY_HOURS=24

# The first admin account, created once at startup if no admin exists yet.
# Only used for that one-time seed — changing these afterwards does nothing;
# change the admin password by logging in and using the app's own "change
# password" action instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Shared access key for the Dashboard's usage endpoints (LLM Cost, Neon DB,
# Backend, Message to Model). Blank = open (fine on your own machine). Set a
# long random value before hosting — the Message to Model feed contains raw
# WhatsApp messages — and build the Dashboard with the same value as
# VITE_DASHBOARD_KEY (in Dashboard/.env).
DASHBOARD_KEY=

# HTTP Basic Auth credentials required to open /docs, /redoc and
# /openapi.json. Blank = open (fine on your own machine). Set BOTH before
# hosting — otherwise anyone with the URL can browse your entire API surface
# (every endpoint, every field) with no login at all.
DOCS_USERNAME=
DOCS_PASSWORD=

# Comma-separated list of extra frontend origins the CORS allow-list
# accepts, on top of the local dev ones — this is where the real, deployed
# frontend domain(s) go (e.g. your Cloudflare Pages URLs). Example:
# https://real-estate-ops.pages.dev,https://real-estate-site.pages.dev
# Leave blank in local development.
EXTRA_CORS_ORIGINS=

# Hugging Face access token (free, read-only: huggingface.co/settings/tokens),
# used when the embedding model is downloaded. Optional — the model is public
# and works without it; the token only lifts the anonymous download rate limit
# and removes the "unauthenticated requests" warning.
HF_TOKEN=
