# Copy this file to `.env` and fill in the real values.

# Google Gemini API key (Google AI Studio) used by the LLM structuring stage.
GEMINI_API_KEY=

# Postgres connection string (with pgvector enabled) used by the property
# database. Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# How long the buffer waits for 10 qualified messages before flushing
# whatever it has anyway, in MINUTES. 60 = 1 hour. Optional — defaults to
# 60 if omitted. Lower this for fast local testing.
BATCH_WINDOW_MINUTES=60
