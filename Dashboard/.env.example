# Where the backend lives. Leave unset to use the same host as this page on
# port 8000 (local development).
# VITE_API_BASE_URL=https://your-backend.up.railway.app/api

# Must equal the backend's DASHBOARD_KEY when that is set
# (see Backend/.env.example). Leave unset when the backend has no key.
# VITE_DASHBOARD_KEY=
