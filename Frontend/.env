# Not a secret. Leave unset (default) so the frontend calls the backend on
# whatever host actually served this page (see src/api/client.ts) — this is
# what makes the WhatsApp inquiry form link work when opened from a phone or
# from this machine's LAN IP, not just "localhost". Only set this to force
# the frontend at a specific backend host/port (e.g. a real deployed
# backend) instead of that same-host default. Override in `.env.local`
# (already gitignored via *.local) rather than editing this file.
VITE_API_BASE_URL=
